<!--
  OpenCore config.plist → Kernel → Add
  将 AppleSunrise.kext（取自 Apple KDK，与系统版本匹配）放入 EFI/OC/Kexts/ 后，合并本条目。
  若 BundlePath 与实际文件名不同，请以实际为准。
-->
<dict>
    <key>Arch</key>
    <string>x86_64</string>
    <key>BundlePath</key>
    <string>AppleSunrise.kext</string>
    <key>Comment</key>
    <string>MediaTek Sunrise HAL (AppleSunrise.kext from KDK)</string>
    <key>Enabled</key>
    <true/>
    <key>ExecutablePath</key>
    <!-- 以 kext Info.plist 中 CFBundleExecutable 为准，通常为 AppleSunrise -->
    <string>Contents/MacOS/AppleSunrise</string>
    <key>MaxKernel</key>
    <string></string>
    <key>MinKernel</key>
    <string></string>
    <key>PlistPath</key>
    <string>Contents/Info.plist</string>
</dict>
